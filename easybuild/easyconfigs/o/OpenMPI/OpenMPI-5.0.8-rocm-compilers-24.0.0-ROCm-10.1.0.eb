easyblock = 'ConfigureMake'

name = 'OpenMPI'
version = '5.0.8'

homepage = 'https://www.open-mpi.org/'
description = """OpenMPI 5.0.8 with ROCm-aware UCX transport."""

toolchain = {'name': 'rocm-compilers', 'version': '24.0.0-ROCm-10.1.0'}

source_urls = ['https://www.open-mpi.org/software/ompi/v%(version_major_minor)s/downloads']
sources = [SOURCELOWER_TAR_BZ2]

dependencies = [
    ('ROCm-Core', '10.1.0', '', SYSTEM),
    ('UCX', '1.18.0'),
]

configopts = (
    '--with-rocm=$EBROOTROCMMINCORE '
    '--with-ucx=$EBROOTUCX '
    '--without-cuda '
    '--enable-mpi-fortran=usempi '
    '--with-pmix=internal '
    '--with-hwloc=internal '
    '--with-libevent=internal'
)

sanity_check_paths = {
    'files': ['bin/mpicc', 'bin/mpicxx', 'bin/mpifort', 'lib/libmpi.so'],
    'dirs': ['include'],
}

moduleclass = 'mpi'
