easyblock = 'CMakeMake'

name = 'ROCm-core'
version = '10.1.0'

homepage = 'https://github.com/ROCm/TheRock'
description = 'ROCm Core SDK components built from TheRock'

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

github_account = 'ROCm'
github_repo = 'TheRock'

sources = [{
    'filename': '%(version)s.tar.gz',
    'download_filename': 'rocm-core.tar.gz',
    'source_urls': [
        'https://github.com/ROCm/rocm-systems/releases/download/therock-10.1/'
    ],
}]

builddependencies = [
    ('CMake', '4.2.1'),
    ('Ninja', '1.13.2'),
]

preconfigopts = 'python3 build_tools/fetch_sources.py && '

configopts = """
-GNinja
-DTHEROCK_ENABLE_ALL=OFF
-DTHEROCK_ENABLE_CORE=ON
-DTHEROCK_ENABLE_COMM_LIBS=OFF
-DTHEROCK_ENABLE_MATH_LIBS=OFF
-DTHEROCK_ENABLE_ML_LIBS=OFF
-DTHEROCK_ENABLE_PROFILER=OFF
-DTHEROCK_AMDGPU_FAMILIES=gfx9;gfx10-3;gfx11;gfx12
"""

separate_build_dir = True

sanity_check_paths = {
    'files': [
        'bin/rocminfo',
    ],
    'dirs': [
        'lib',
        'include',
    ],
}

moduleclass = 'devel'
